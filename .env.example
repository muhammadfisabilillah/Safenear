# SAFE NEAR — environment (OPSIONAL).
# Tidak ada rahasia di repository ini. Salin ke .env.local bila perlu.

# Overpass API endpoint (default: https://ovp.dresel.systems/api-na/interpreter)
# Kosongkan untuk memakai daftar default di scripts/fetch-poi.ts
OVERPASS_ENDPOINT=

# OSRM routing (opsional). Kosongkan = memakai Google Maps URLs (api=1)
OSRM_URL=

# Basemap style (default: OpenFreeMap liberty)
MAP_STYLE=https://tiles.openfreemap.org/styles/liberty

# Nominatim (bila dipakai; wajib User-Agent sesuai usage policy)
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org

# Aset PMTiles/basemap (bila self-host di Cloudflare R2)
PMTILES_URL=
